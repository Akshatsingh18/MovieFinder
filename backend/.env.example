TMDB_API_KEY=replace_with_your_tmdb_key
# Comma-separated; the backend uses keys in order and switches after a key is exhausted.
OMDB_API_KEYS=replace_with_key_1,replace_with_key_2,replace_with_key_3
# OMDB_API_KEY remains supported as a single-key fallback.
# Downloads IMDb's daily title-ratings dataset after OMDb completes.
IMDB_DATASET_ENABLED=true
# Daily at 04:30 Asia/Kolkata. It streams the file in Render and saves matching rows in PostgreSQL.
IMDB_DATASET_CRON=0 30 4 * * *
DB_URL=jdbc:postgresql://127.0.0.1:5432/movie_finder
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_postgres_password
APP_REGION=IN
FRONTEND_ORIGIN=http://localhost:5173
